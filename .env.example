# Set sensitive values using your hosting platform's secret store, not in Git.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set JWT_SECRET or reuse the project's existing SESSION_SECRET (minimum 32 characters).
JWT_SECRET=
SESSION_SECRET=
PORT=8080
# Leave empty for same-origin modules. Exact origins only, comma-separated; no wildcards.
CORS_ORIGINS=
# Reserved for Rohan's future speech pipeline. These do not activate a fabricated adapter.
GNANI_API_KEY=
GNANI_PRISMA_ENDPOINT=
GNANI_TIMBRE_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=
